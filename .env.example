# Copia como .env para desarrollo local. En Botkeep usa la pestaña Environment.

# Obligatoria. Botkeep → PostgreSQL → pestaña Database. TLS con verificación del certificado:
# certs/botkeep-ca.pem es el CA del panel (en Botkeep: /home/container/certs/botkeep-ca.pem).
DATABASE_URL=postgresql://usuario:clave@host:5432/base?sslmode=verify-full&sslrootcert=certs/botkeep-ca.pem

# Memoria por ordenamiento en las conexiones de la API (las estadísticas ordenan en memoria
# en vez de en disco). 32MB va bien con 1,5 GB de RAM para PostgreSQL.
PG_WORK_MEM=32MB

# Botkeep la define sola; en local se usa 8000 si falta.
# SERVER_PORT=8000

# Publicar IPs agrupadas en /24 (IPv4) y /48 (IPv6). Recomendado: true.
PUBLIC_MASK_IPS=true

# Días que se conservan los eventos (30 = el rango máximo que muestra el dashboard).
RETENTION_DAYS=30

# Zona horaria de las etiquetas del dashboard.
DISPLAY_TZ=America/Bogota

SITE_TITLE=Ataques a 0r1sk.xyz
SOURCE_URL=https://github.com/DavePineda/attack-dashboard

# Opcional: base de países .mmdb local (DB-IP Lite o GeoLite2).
GEOIP_DB=
GEOIP_ATTRIBUTION=Geolocalización por país: DB-IP.com (CC BY 4.0)

# IP del visitante para el limitador: última de X-Forwarded-For (proxy de Botkeep).
TRUST_PROXY=true
# IPs o redes del proxy de Botkeep, separadas por comas. Si se define, toda conexión que no
# venga de ellas recibe 403: cierra el puerto directo del nodo, donde X-Forwarded-For se
# podría falsificar. La IP aparece como "conexión de ..." en los avisos de ingesta rechazada.
# TRUSTED_PROXIES=
# Solo si el dominio pasa por el proxy de Cloudflare:
# CLIENT_IP_HEADER=cf-connecting-ip
