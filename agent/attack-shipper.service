[Unit]
Description=Envía eventos de Fail2ban y UFW al dashboard de ataques
Documentation=https://github.com/DavePineda/attack-dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=attack-shipper
Group=attack-shipper
# El grupo adm puede leer /var/log/fail2ban.log y /var/log/ufw.log en Debian/Ubuntu.
SupplementaryGroups=adm
EnvironmentFile=/etc/attack-shipper/shipper.env
ExecStart=/usr/bin/python3 -I /opt/attack-shipper/shipper.py
StateDirectory=attack-shipper
StateDirectoryMode=0700
TimeoutStartSec=120

# --- Endurecimiento: el agente solo lee logs y hace HTTPS saliente ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# Sin ProcSubset=pid: el agente necesita /proc/stat, /proc/meminfo y /proc/loadavg para el
# estado del servidor. ProtectProc=invisible sigue ocultando los demás procesos.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=128M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
