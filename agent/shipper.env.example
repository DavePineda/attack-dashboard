# /etc/attack-shipper/shipper.env  (permisos 0640 root:attack-shipper)

# URL pública de la API en Botkeep (siempre https)
SHIPPER_ENDPOINT=https://dash.0r1sk.xyz/api/v1/ingest

# Token generado con tools/new_sensor.py (uno distinto por VPS)
SHIPPER_TOKEN=

# Logs a leer. Deja uno vacío para desactivarlo.
SHIPPER_FAIL2BAN_LOG=/var/log/fail2ban.log
SHIPPER_UFW_LOG=/var/log/ufw.log

# Ventana de agregación de UFW en segundos (debe dividir 86400). 600 = 10 minutos.
SHIPPER_BUCKET_SECONDS=600

# Redes a ignorar (tus propias IPs, la VPN, tu casa…), separadas por comas.
SHIPPER_IGNORE_NETS=

# Solo para la primera ejecución: 1 = enviar el historial que ya hay en los logs.
SHIPPER_BACKFILL=0
